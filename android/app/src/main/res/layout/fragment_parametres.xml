<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fond" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Mon magasin" android:textColor="@color/texte" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/nom_magasin">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNomMagasin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/btnEnregistrerMagasin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="12dp" android:text="@string/enregistrer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Accès et catalogue" android:textColor="@color/texte" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnChangerPinManager" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="PIN du gérant" android:textSize="14sp" android:paddingHorizontal="8dp" app:cornerRadius="8dp" app:icon="@drawable/ic_settings" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnChangerPinCaissier" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="PIN du caissier" android:textSize="14sp" android:paddingHorizontal="8dp" app:cornerRadius="8dp" app:icon="@drawable/ic_settings" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCategories" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/gerer_categories" android:textSize="14sp" android:paddingHorizontal="8dp" app:cornerRadius="8dp" app:icon="@drawable/ic_category" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Fournisseurs" android:textColor="@color/texte" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <LinearLayout android:id="@+id/llFournisseurs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAjouterFournisseur" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/ajouter_fournisseur" android:textSize="14sp" android:paddingHorizontal="8dp" app:cornerRadius="8dp" app:icon="@drawable/ic_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Données de démonstration" android:textColor="@color/texte" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Utilisez des exemples pour découvrir le mode local." android:textSize="13sp" android:textColor="@color/gris" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnChargerDemo" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:text="@string/charger_demo" android:textSize="14sp" android:paddingHorizontal="8dp" app:cornerRadius="8dp"  />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
